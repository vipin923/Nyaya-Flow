@page "/vault-records"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IConfiguration _config
@using Nyaya_Flow.Models
@using Nyaya_Flow.Services
@inject NyayaFlowServices nyayaFlowServices
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudText Typo="Typo.h4" GutterBottom="true"><b>BNS Evidence Ledger</b></MudText>
    <MudText Typo="Typo.body1" Class="mb-6">
        Secure cryptographic view of all processed media. Client identities are obfuscated via SHA-256 hashing.
    </MudText>

    <MudTable Items="@_vaultRecords" Hover="true" Dense="true" Striped="true" Loading="@_isLoading" LoadingProgressColor="Color.Info" Elevation="4">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Cryptographic Chain of Custody</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="Search by Hash or Seal..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<EvidenceStore, object>(x=>x.UploadTimestamp)">Timestamp (UTC)</MudTableSortLabel></MudTh>
            <MudTh>Status</MudTh>
            <MudTh>AI Probability</MudTh>
            <MudTh>Client Identity (Hashed)</MudTh>
            <MudTh>Digital Evidence Seal</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Timestamp">@context.UploadTimestamp.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsAdmissible)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">AI Generated</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">Real Pixel</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="AI Probability"><b>@context.SyntheticProbability%</b></MudTd>
            
            <MudTd DataLabel="Client Identity">
                    <MudText Typo="Typo.body2" Style="font-family: monospace; color: #9e9e9e;">
                        @context.ClientName
                    </MudText>
            </MudTd>
            
            <MudTd DataLabel="Digital Seal">
                <MudTooltip Text="@context.DigitalSeal" Placement="Placement.Top">
                    <MudText Typo="Typo.body2" Style="font-family: monospace; color: #64b5f6;">
                        @TruncateHash(context.DigitalSeal)
                    </MudText>
                </MudTooltip>
            </MudTd>
            
            <MudTd DataLabel="Actions">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="@(() => ViewDetails(context.EvidenceId))">
                    View
                </MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

</MudContainer>

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private List<EvidenceStore> _vaultRecords = new List<EvidenceStore>();

    protected override async Task OnInitializedAsync()
    {
        await LoadVaultDataAsync();
    }

    private async Task LoadVaultDataAsync()
    {
        _isLoading = true;
      

                
                _vaultRecords = await nyayaFlowServices.EvidenceLog();
            }
       
    

    // Helper to make 64-character hashes readable in the UI
    private string TruncateHash(string fullHash)
    {
        if (string.IsNullOrEmpty(fullHash) || fullHash.Length <= 16) return fullHash;
        return $"{fullHash.Substring(0, 8)}...{fullHash.Substring(fullHash.Length - 8)}";
    }

    private void ViewDetails(Guid id)
    {
        // TODO: Navigate to a detailed view where you can download the actual EvidenceFile bytes
        Console.WriteLine($"Opening details for {id}");
    }

    // The C# Model that maps exactly to your SQL Table (excluding the binary file)
   
}